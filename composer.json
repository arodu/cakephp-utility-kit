{
    "name": "arodu/cakephp-utility-kit",
    "description": "UtilityKit plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "cakephp/cakephp-codesniffer": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "UtilityKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UtilityKit\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "cs-check": "phpcs --standard=phpcs.xml src tests",
        "cs-fix": "phpcbf --standard=phpcs.xml src tests"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
